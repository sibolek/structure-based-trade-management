{
  "name": "structure-based-trade-management",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "v24:pretrade": "node schwab-bridge/pretrade-api.mjs",
    "v24:market-data-test": "node --test tests/market-data-provider.test.mjs",
    "v24:market-data-probe": "node schwab-bridge/market-data-probe.mjs",
    "v24:dss-live-probe": "node schwab-bridge/dss-live-probe.mjs",
    "v24:dss-test": "node --test tests/pretrade-state.test.mjs tests/wilder-atr.test.mjs tests/effective-stop.test.mjs tests/dss-evaluator.test.mjs tests/dss-evaluation-lifecycle.test.mjs tests/dss-runtime.test.mjs tests/dss-input-assembler.test.mjs tests/dss-live-probe.test.mjs tests/reg-nms-equity-price-increment.test.mjs tests/dss-permission-service.test.mjs",
    "schwab:auth": "node schwab-bridge/index.mjs auth",
    "schwab:account": "node schwab-bridge/index.mjs account",
    "schwab:monitor": "node schwab-bridge/monitor.mjs",
    "schwab:history": "node schwab-bridge/history.mjs",
    "schwab:history-export": "node schwab-bridge/history.mjs --days=30 --quiet --export=research/30-day-management-study/raw-schwab-history.json",
    "schwab:price-history-test": "node schwab-bridge/price-history-test.mjs",
    "schwab:replay": "node schwab-bridge/replay.mjs",
    "schwab:eod": "node schwab-bridge/eod-report.mjs",
    "schwab:slippage": "node schwab-bridge/slippage.mjs",
    "schwab:state-test": "node schwab-bridge/state-test.mjs",
    "schwab:token-test": "node schwab-bridge/token-test.mjs",
    "schwab:status": "node schwab-bridge/index.mjs status",
    "schwab:logout": "node schwab-bridge/index.mjs logout",
    "analytics:test": "node --test tests/*.test.mjs",
    "analytics:report": "node research/30-day-management-study/run-study.mjs",
    "analytics:duration": "node research/30-day-management-study/run-study.mjs --section duration",
    "analytics:stops": "node research/30-day-management-study/run-study.mjs --section stops",
    "analytics:r": "node research/30-day-management-study/run-study.mjs --section r",
    "analytics:mfe": "node research/30-day-management-study/run-study.mjs --section mfe",
    "analytics:capture": "node research/30-day-management-study/run-study.mjs --section capture",
    "analytics:counterfactuals": "node research/30-day-management-study/run-study.mjs --section counterfactuals",
    "research:30day-management": "node research/30-day-management-study/run-study.mjs",
    "research:normalize-30day": "node research/30-day-management-study/normalize-schwab-history.mjs",
    "research:reconstruct-30day": "npm run schwab:history-export && npm run research:normalize-30day && npm run analytics:report",
    "research:diagnose-window": "node research/30-day-management-study/diagnose-window.mjs",
    "research:diagnose-extra-winner": "node research/30-day-management-study/diagnose-single-extra-winner.mjs",
    "research:diagnose-one-trade-delta": "node research/30-day-management-study/diagnose-one-trade-delta.mjs",
    "research:diagnose-stops": "node research/30-day-management-study/diagnose-stop-history.mjs",
    "research:diagnose-stop-linkage": "node research/30-day-management-study/diagnose-stop-linkage.mjs",
    "research:enrich-stops": "node research/30-day-management-study/enrich-stop-history.mjs",
    "research:report-recovered": "node research/30-day-management-study/run-study.mjs --input research/30-day-management-study/historical-study-trades.json",
    "research:diagnose-r": "node research/30-day-management-study/diagnose-initial-risk.mjs",
    "research:diagnose-r-winners": "node research/30-day-management-study/diagnose-r-winner-delta.mjs",
    "research:diagnose-r-provenance": "node research/30-day-management-study/diagnose-r-provenance.mjs",
    "research:diagnose-r-lifecycle": "node research/30-day-management-study/diagnose-r-stop-lifecycle.mjs",
    "research:diagnose-r-basis": "node research/30-day-management-study/diagnose-r-basis.mjs",
    "research:audit-market-data": "node research/30-day-management-study/audit-market-data.mjs",
    "research:diagnose-fast-winners": "node research/30-day-management-study/diagnose-fast-winner-sample.mjs",
    "research:diagnose-fast-winner-strata": "node research/30-day-management-study/diagnose-fast-winner-strata.mjs",
    "research:validate-fast-winners-schwab": "node research/30-day-management-study/validate-fast-winner-candidates-schwab.mjs",
    "research:diagnose-minute-alignment": "node research/30-day-management-study/diagnose-minute-bar-alignment.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20"
  }
}
